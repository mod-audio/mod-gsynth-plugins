@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://mod.audio/plugins/gsynth-flexible>
    a lv2:Plugin ;
    lv2:binary <mod-gsynth-flexible.so> ;
    rdfs:seeAlso <mod-gsynth-flexible.ttl> .

<https://mod.audio/plugins/gsynth-flexible>
    rdfs:seeAlso <modgui.ttl> .

<https://mod.audio/plugins/gsynth-flexible#preset-acid-saw-bass>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-flexible> ; rdfs:label "Acid Saw Bass" ; rdfs:seeAlso <presets.ttl> .

<https://mod.audio/plugins/gsynth-flexible#preset-acid-square-bass>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-flexible> ; rdfs:label "Acid Square Bass" ; rdfs:seeAlso <presets.ttl> .

<https://mod.audio/plugins/gsynth-flexible#preset-plus4-and-plus5>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-flexible> ; rdfs:label "+4 and +5" ; rdfs:seeAlso <presets.ttl> .

<https://mod.audio/plugins/gsynth-flexible#preset-minor-dub>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-flexible> ; rdfs:label "Minor Dub" ; rdfs:seeAlso <presets.ttl> .

<https://mod.audio/plugins/gsynth-flexible#preset-octave-lead>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-flexible> ; rdfs:label "Octave Lead" ; rdfs:seeAlso <presets.ttl> .

