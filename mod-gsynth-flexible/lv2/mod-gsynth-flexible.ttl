<https://mod.audio/plugins/gsynth-flexible#group-vco>
    a pg:InputGroup ;
    lv2:symbol "vco" ;
    lv2:name "VCO" ;
    lv2:index 0 .

<https://mod.audio/plugins/gsynth-flexible#group-vcf>
    a pg:InputGroup ;
    lv2:symbol "vcf" ;
    lv2:name "VCF" ;
    lv2:index 1 .

<https://mod.audio/plugins/gsynth-flexible#group-vca>
    a pg:InputGroup ;
    lv2:symbol "vca" ;
    lv2:name "VCA / Dynamics" ;
    lv2:index 2 .

<https://mod.audio/plugins/gsynth-flexible#group-fx>
    a pg:InputGroup ;
    lv2:symbol "fx" ;
    lv2:name "FX" ;
    lv2:index 3 .
