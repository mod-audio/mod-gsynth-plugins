        lv2:symbol "vco23" ;
        lv2:name "VCO 2+3" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:toggled ;
