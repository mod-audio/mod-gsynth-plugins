        lv2:symbol "vco2_oct" ;
        lv2:name "VCO 2 Octave" ;
        lv2:shortName "VCO2 Oct" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 6 ;
        lv2:portProperty lv2:integer ;
        pg:group <https://mod.audio/plugins/gsynth-flexible#group-vco> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "vco2_semi" ;
        lv2:name "VCO 2 Semitones" ;
        lv2:shortName "VCO2 Semi" ;
        lv2:default 7 ;
        lv2:minimum 0 ;
        lv2:maximum 12 ;
        lv2:portProperty lv2:integer ;
        pg:group <https://mod.audio/plugins/gsynth-flexible#group-vco> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "vco3_oct" ;
        lv2:name "VCO 3 Octave" ;
        lv2:shortName "VCO3 Oct" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 6 ;
        lv2:portProperty lv2:integer ;
        pg:group <https://mod.audio/plugins/gsynth-flexible#group-vco> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "vco3_semi" ;
        lv2:name "VCO 3 Semitones" ;
