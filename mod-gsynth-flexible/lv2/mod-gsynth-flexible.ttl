        lv2:maximum 1 ;
        lv2:portProperty lv2:integer, lv2:toggled ;
        pg:group <https://mod.audio/plugins/gsynth-flexible#group-vco> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "lfo_vco_wave" ;
        lv2:name "LFO>VCO Wave" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 5 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Sine" ; rdf:value 0 ] ,
                       [ rdfs:label "Triangle" ; rdf:value 1 ] ,
                       [ rdfs:label "Sawtooth Up" ; rdf:value 2 ] ,
                       [ rdfs:label "Sawtooth Down" ; rdf:value 3 ] ,
                       [ rdfs:label "Rectangle" ; rdf:value 4 ] ,
                       [ rdfs:label "S & H" ; rdf:value 5 ] ;
