@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://mod.audio/plugins/gsynth-flexible>
    a lv2:Plugin, lv2:GeneratorPlugin, doap:Project ;

    doap:name "GSynth Flexible" ;
    doap:license <http://opensource.org/licenses/GPL-3.0> ;
    doap:maintainer [
        foaf:name "MOD Audio" ;
        foaf:homepage <https://mod.audio> ;
    ] ;

    lv2:project <https://mod.audio/plugins/gsynth-flexible> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 1 ;

    mod:brand "MOD" ;
    mod:label "GSynth Flex" ;

    rdfs:comment """The full GSYNTH guitar synthesizer: every control of MOD's "GSYNTH:Flexible" pedalboard, in one plugin. Play single notes on a guitar or bass; the pitch is tracked and drives up to three oscillators, a filter and an amplifier, and your picking dynamics shape the sound. The original signal is not mixed into the output.

VCO: VCO 2+3 switches two more sawtooth oscillators in, tuned in octaves and semitones above the first. LFO>VCO is vibrato.

VCF: the cutoff follows the note (KEY>VCF), your picking (DYN>VCF) and an LFO (LFO>VCF). Filter > and Filter < sweep it up or down while held, taking Filter Time; they are made for footswitches.

VCA: FIX>VCA gives every note the same level, DYN>VCA follows your picking. Compress Dynamics evens the picking out before it is measured.

Turn Sensitivity down if the synth reacts to string noise, up if soft notes are missed.""" ;

    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R" ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "octave" ;
        lv2:name "Master Octave" ;
        lv2:shortName "Mstr Oct" ;
        lv2:default -1 ;
        lv2:minimum -4 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer ;
        pg:group <https://mod.audio/plugins/gsynth-flexible#group-vco> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "vco1_wave" ;
        lv2:name "VCO 1 Wave" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 6 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Sine" ; rdf:value 0 ] ,
                       [ rdfs:label "Triangle" ; rdf:value 1 ] ,
                       [ rdfs:label "Sawtooth" ; rdf:value 2 ] ,
                       [ rdfs:label "Rectangle" ; rdf:value 3 ] ,
                       [ rdfs:label "Aux Saw 1" ; rdf:value 4 ] ,
                       [ rdfs:label "Aux Saw 2" ; rdf:value 5 ] ,
                       [ rdfs:label "Aux Saw 3" ; rdf:value 6 ] ;
        pg:group <https://mod.audio/plugins/gsynth-flexible#group-vco> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
