<https://mod.audio/plugins/gsynth-flexible#preset-acid-saw-bass>
    a pset:Preset ;
    lv2:appliesTo <https://mod.audio/plugins/gsynth-flexible> ;
    rdfs:label "Acid Saw Bass" ;
    lv2:port [ lv2:symbol "octave" ; pset:value -1.0 ] ;
