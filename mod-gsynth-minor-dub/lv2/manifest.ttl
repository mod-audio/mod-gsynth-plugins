@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://mod.audio/plugins/gsynth-minor-dub>
    a lv2:Plugin ;
    lv2:binary <mod-gsynth-minor-dub.so> ;
    rdfs:seeAlso <mod-gsynth-minor-dub.ttl> .

<https://mod.audio/plugins/gsynth-minor-dub>
    rdfs:seeAlso <modgui.ttl> .

<https://mod.audio/plugins/gsynth-minor-dub#preset-minor-dub>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-minor-dub> ; rdfs:label "Minor Dub" ; rdfs:seeAlso <presets.ttl> .

<https://mod.audio/plugins/gsynth-minor-dub#preset-deep-dub>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-minor-dub> ; rdfs:label "Deep Dub" ; rdfs:seeAlso <presets.ttl> .

<https://mod.audio/plugins/gsynth-minor-dub#preset-wide-space>
    a pset:Preset ; lv2:appliesTo <https://mod.audio/plugins/gsynth-minor-dub> ; rdfs:label "Wide Space" ; rdfs:seeAlso <presets.ttl> .
