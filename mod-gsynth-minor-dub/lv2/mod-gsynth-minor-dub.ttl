@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .

<https://mod.audio/plugins/gsynth-minor-dub>
    a lv2:Plugin, lv2:GeneratorPlugin, doap:Project ;

    doap:name "GSynth Minor Dub" ;
    doap:license <http://opensource.org/licenses/GPL-3.0> ;
    doap:maintainer [
        foaf:name "MOD Audio" ;
        foaf:homepage <https://mod.audio> ;
    ] ;

    lv2:project <https://mod.audio/plugins/gsynth-minor-dub> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 1 ;

    mod:brand "MOD" ;
    mod:label "Minor Dub" ;

    rdfs:comment """Every note you play becomes a minor chord: three sawtooth oscillators a minor third and a fifth apart, through a mellow filter into a dub delay and a plate reverb. Play single notes on a guitar or bass; the original signal is not mixed into the output.

Echo brings the delay up and lengthens its repeats together. Space does the same for the reverb.

One voicing of MOD's "GSYNTH:Flexible" pedalboard.""" ;

    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Input" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R" ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "cutoff" ;
        lv2:name "Cutoff" ;
        lv2:default 2.1 ;
        lv2:minimum 0.0 ;
        lv2:maximum 6.0 ;
        pg:group <https://mod.audio/plugins/gsynth-minor-dub#group-vcf> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance" ;
        lv2:default 0.376 ;
        lv2:minimum 0.01 ;
        lv2:maximum 1.0 ;
        pg:group <https://mod.audio/plugins/gsynth-minor-dub#group-vcf> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "echo" ;
        lv2:name "Echo" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group <https://mod.audio/plugins/gsynth-minor-dub#group-fx> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "space" ;
        lv2:name "Space" ;
        lv2:default 0.4 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        pg:group <https://mod.audio/plugins/gsynth-minor-dub#group-fx> ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:default 0.0 ;
        lv2:minimum -20.0 ;
        lv2:maximum 20.0 ;
        units:unit units:db ;
        pg:group <https://mod.audio/plugins/gsynth-minor-dub#group-vca> ;
    ] , [
        a lv2:ControlPort, lv2:OutputPort ;
        lv2:index 8 ;
        lv2:symbol "detected_pitch" ;
        lv2:name "Detected Pitch" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 22050.0 ;
        units:unit units:hz ;
    ] .

<https://mod.audio/plugins/gsynth-minor-dub#group-vcf>
    a pg:InputGroup ;
    lv2:symbol "vcf" ;
    lv2:name "VCF" ;
    lv2:index 0 .

<https://mod.audio/plugins/gsynth-minor-dub#group-vca>
    a pg:InputGroup ;
    lv2:symbol "vca" ;
    lv2:name "VCA / Dynamics" ;
    lv2:index 1 .

<https://mod.audio/plugins/gsynth-minor-dub#group-fx>
    a pg:InputGroup ;
    lv2:symbol "fx" ;
    lv2:name "FX" ;
    lv2:index 2 .
